#!/usr/bin/env zsh
usage='clean-test [-- <install-cleanup.sh flags>]   run install-cleanup.sh --yes from
windroc-labs/ensemble as a user would, in this Terminal; its sudo password is typed at its prompt (mini pw
from mini-op). REF=<ref> (default main) picks the branch or commit; flags after -- go to
install-cleanup.sh unchanged. Prints "install-cleanup.sh exited <rc>"; exits 0 (it exited 0), 1
(the download failed, or it exited non-zero) or 2 (usage error).'
[[ $# -eq 1 && $1 == -h ]] && { print -r -- $usage; exit 0; }
[[ $# -eq 0 || $1 == -- ]] ||
  { print -u2 -r -- 'clean-test: usage: clean-test [-- <install-cleanup.sh flags>]'; exit 2; }
shift $(( $# > 0 ))
ref=${REF:-main}
url=https://raw.githubusercontent.com/windroc-labs/ensemble/$ref/scripts/install-cleanup.sh
script=$(curl -fsSL $url) ||
  { print -u2 -r -- "clean-test: cannot fetch $url; ran nothing"; exit 1; }
bash -c "$script" install-cleanup.sh \
    --yes "$@"
rc=$?
echo "install-cleanup.sh exited $rc"
(( rc == 0 ))
