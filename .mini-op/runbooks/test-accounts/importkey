#!/usr/bin/env zsh
usage="importkey <keychain> <service> <account> [<new-service> [<new-account>]]   the mini account's
password on stdin: unlock the login keychain and <keychain> (an exported keychain with the same
password) with it, copy the generic password <service>/<account> from <keychain> into the login
keychain as <new-service>/<new-account> (each defaults to the old one; label the service), lock
<keychain> again and print the check. The password and the item never print. Exits 0, 1 (the item
is not in <keychain>, holds a quote, backslash or newline, or is not in the login keychain
afterwards) or 2 (usage error)."
[[ $# -eq 1 && $1 == -h ]] && { print -r -- $usage; exit 0; }
name='^[A-Za-z0-9][A-Za-z0-9._@+:-]*$'
[[ $# -ge 3 && $# -le 5 && -n $1 && $1 != *[[:space:]\'\"\\]* && $2 =~ $name && $3 =~ $name &&
  ( $# -lt 4 || $4 =~ $name ) && ( $# -lt 5 || $5 =~ $name ) ]] || {
  print -u2 -r -- 'importkey: usage: importkey <keychain> <service> <account> [<new-service> [<new-account>]]'
  exit 2
}
source ~/apm/lib/keychain.zsh || exit 1
kc=$1; s=$2; a=$3; ns=${4:-$2}; na=${5:-$3}
die() { print -u2 -r -- "importkey: $1"; exit 1; }
trap 'security lock-keychain "$kc" >/dev/null 2>&1' EXIT
# The password and the item reach security -i only through builtin printf pipes.
IFS= read -r pass
printf 'unlock-keychain -p "%s" login.keychain\nunlock-keychain -p "%s" "%s"\n' "$pass" "$pass" "$kc" |
  security -i >/dev/null 2>&1
unset pass
keychain_has "$s" "$a" "$kc" || die "$s/$a not in $kc; imported nothing"
# zsh runs a pipeline's last command in this shell: value stays set and pipestatus has the read's rc.
keychain_read "$s" "$a" "$kc" 2>/dev/null | IFS= read -r -d '' value
(( pipestatus[1] == 0 )) || { unset value; die "cannot read $s/$a from $kc; imported nothing"; }
value=${value%$'\n'}
if [[ $value == *[\"\\$'\n']* ]]; then
  unset value
  die "$s/$a holds a quote, backslash or newline; imported nothing"
fi
printf 'add-generic-password -U -s %s -a %s -l "%s" -w "%s" login.keychain\n' "$ns" "$na" "$ns" "$value" |
  security -i >/dev/null 2>&1
unset value
keychain_has "$ns" "$na" login.keychain || die "$ns/$na is not in the login keychain"
if [[ $ns/$na == $s/$a ]]; then
  print -r -- "importkey: $s/$a imported"
else
  print -r -- "importkey: $s/$a imported as $ns/$na"
fi
