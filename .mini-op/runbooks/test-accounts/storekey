#!/usr/bin/env zsh
usage="storekey <service> <account>   the mini account's password on stdin: store the Linear API
key on the clipboard in the login keychain as <service>/<account>, clear the clipboard, and print
the key's viewer as the check. The key never prints. Exits 0, 1 (the clipboard holds no Linear
key, the key is not in the keychain afterwards, or the check request failed) or 2 (usage error)."
[[ $# -eq 1 && $1 == -h ]] && { print -r -- $usage; exit 0; }
[[ $# -eq 2 && $1 =~ '^[A-Za-z0-9][A-Za-z0-9._@+:-]*$' && $2 =~ '^[A-Za-z0-9][A-Za-z0-9._@+:-]*$' ]] ||
  { print -u2 -r -- 'storekey: usage: storekey <service> <account>'; exit 2; }
source ~/apm/lib/secrets.zsh || exit 1
source ~/apm/lib/keychain.zsh || exit 1
s=$1; a=$2
# The password and the key reach security -i only through builtin printf pipes.
IFS= read -r pass; printf 'unlock-keychain -p "%s" login.keychain\n' "$pass" | security -i >/dev/null 2>&1; unset pass
IFS= read -r -d '' key < <(pbpaste); key=${key%$'\n'}
print -r -- "$key" | secret_is linear ||
  { print -u2 -r -- 'storekey: clipboard holds no Linear key; stored nothing'; exit 1; }
printf 'add-generic-password -U -s %s -a %s -l "%s" -w "%s"\n' "$s" "$a" "$s" "$key" | security -i >/dev/null 2>&1; unset key
printf x | pbcopy
keychain_read "$s" "$a" | sed 's/^/Authorization: /' |
  curl -s https://api.linear.app/graphql -H @- -H 'Content-Type: application/json' -d '{"query":"{ viewer { name email } }"}'
st=($pipestatus); echo
(( st[1] == 0 )) || { print -u2 -r -- "storekey: $s/$a is not in the keychain"; exit 1; }
(( st[3] == 0 )) || { print -u2 -r -- "storekey: the check's curl exited $st[3]"; exit 1; }
