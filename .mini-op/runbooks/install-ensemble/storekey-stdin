#!/usr/bin/env zsh
usage="storekey-stdin <service> <account>   the mini account's password on the first line of stdin,
then a key: store the key in the login keychain as <service>/<account> (label the service; an
existing item is updated) and print the check. Blank lines around the key are dropped. The
password and the key never print. Exits 0, 1 (the key is empty or holds a quote, backslash or
newline, or is not in the login keychain afterwards) or 2 (usage error)."
[[ $# -eq 1 && $1 == -h ]] && { print -r -- $usage; exit 0; }
name='^[A-Za-z0-9][A-Za-z0-9._@+:-]*$'
[[ $# -eq 2 && $1 =~ $name && $2 =~ $name ]] ||
  { print -u2 -r -- 'storekey-stdin: usage: storekey-stdin <service> <account>'; exit 2; }
source ~/apm/lib/keychain.zsh || exit 1
s=$1; a=$2
die() { print -u2 -r -- "storekey-stdin: $1"; exit 1; }
# The password and the key reach security -i only through builtin printf pipes.
IFS= read -r pass
IFS= read -r -d '' key
while [[ $key == $'\n'* ]]; do key=${key#$'\n'}; done
while [[ $key == *$'\n' ]]; do key=${key%$'\n'}; done
if [[ -z $key || $key == *[\"\\$'\n']* ]]; then
  unset pass key
  die 'the key is empty or holds a quote, backslash or newline; stored nothing'
fi
printf 'unlock-keychain -p "%s" login.keychain\n' "$pass" | security -i >/dev/null 2>&1
unset pass
printf 'add-generic-password -U -s %s -a %s -l "%s" -w "%s" login.keychain\n' "$s" "$a" "$s" "$key" |
  security -i >/dev/null 2>&1
unset key
keychain_has "$s" "$a" login.keychain || die "$s/$a is not in the login keychain"
print -r -- "storekey-stdin: $s/$a stored"
