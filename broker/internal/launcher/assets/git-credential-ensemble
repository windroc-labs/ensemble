#!/opt/ensemble/venv/bin/python -I
"""git's credential helper for github.com over https: the installation token of the path's owner."""

import os
import re
import sys
from pathlib import Path

TOKENS = Path("/run/ensemble/secrets/github")
LOGIN = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]{0,38}")


def token(owner, tokens=TOKENS):
    """owner's token: the file named owner, compared lowercased; None for none."""
    if not LOGIN.fullmatch(owner):
        return None
    try:
        names = [name for name in os.listdir(tokens) if name.lower() == owner.lower()]
        found = (tokens / names[0]).read_text(encoding="utf-8").strip() if names else ""
    except OSError:
        return None
    return found or None


def main(argv, stdin=sys.stdin, tokens=TOKENS):
    if argv != ["get"]:
        return
    fields = dict(line.split("=", 1) for line in stdin.read().splitlines() if "=" in line)
    if fields.get("protocol") != "https" or fields.get("host") != "github.com":
        return
    found = token(fields.get("path", "").split("/")[0], tokens)
    if found:
        print(f"username=x-access-token\npassword={found}")


if __name__ == "__main__":
    main(sys.argv[1:])
