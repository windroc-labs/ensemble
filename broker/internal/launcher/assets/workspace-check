#!/opt/ensemble/venv/bin/python
"""Prints {"dirty": [...]}: the repos at most three levels under a workspace mount point with
uncommitted, stashed or unpushed work, relative to it; changes under the package cache dir
(the broker names it) are not work. Run by ensemble-broker workspace-rm on a
read-only mount with no network.
"""

import json
import os
import re
import subprocess
import sys

DEPTH = 3
GIT = (
    "git",
    "--no-optional-locks",
    "-c",
    "core.fsmonitor=false",
    "-c",
    "core.hooksPath=/dev/null",
    "-c",
    "safe.directory=*",
)
CONTROL = re.compile(r"[\x00-\x1f\x7f]")


def repos(root, cache):
    """(root and the directories up to DEPTH below it holding .git, skipping .git and cache; the
    directories it cannot list, which may hide work).
    """
    found, blocked, todo = [], [], [(root, 0)]
    while todo:
        path, level = todo.pop()
        if os.path.lexists(os.path.join(path, ".git")):
            found.append(path)
        if level == DEPTH:
            continue
        try:
            entries = list(os.scandir(path))
        except OSError:
            blocked.append(path)
            continue
        todo += [
            (entry.path, level + 1)
            for entry in entries
            if entry.name not in (".git", cache) and entry.is_dir(follow_symlinks=False)
        ]
    return sorted(found), blocked


def unsaved(path, cache, run):
    """Whether git reports work in path, or cannot tell."""
    for check in (
        ("status", "--porcelain", "--untracked-files=all", "--", ".", f":(exclude){cache}"),
        ("rev-list", "--all", "--not", "--remotes"),
    ):
        try:
            res = run([*GIT, *check], cwd=path, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError):
            return True
        if res.returncode or res.stdout.strip():
            return True
    return False


def dirty(root, cache, run=subprocess.run):
    found, blocked = repos(root, cache)
    return [
        CONTROL.sub(lambda m: f"\\x{ord(m.group()):02x}", os.path.relpath(path, root))
        for path in sorted({*blocked, *(path for path in found if unsaved(path, cache, run))})
    ]


def main(argv):
    if (
        len(argv) != 2
        or not os.path.isabs(argv[0])
        or os.sep in argv[1]
        or argv[1] in ("", ".", "..")
    ):
        sys.exit("usage: workspace-check MOUNT_POINT CACHE_DIR_NAME")
    print(json.dumps({"dirty": dirty(*argv)}))


if __name__ == "__main__":
    main(sys.argv[1:])
