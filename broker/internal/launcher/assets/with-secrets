#!/opt/ensemble/venv/bin/python
import os
import sys
from pathlib import Path

SECRET = Path("/run/ensemble/secrets/claude")


def main(argv, secret=SECRET):
    if len(argv) < 3 or argv[0] != "--client" or argv[1] not in ("claude", "codex", "opencode"):
        sys.exit("usage: with-secrets --client claude|codex|opencode COMMAND [ARG...]")
    client, argv = argv[1], argv[2:]
    if client != "claude":  # Codex and OpenCode read their files
        return os.execvpe(argv[0], argv, os.environ)
    try:
        token = secret.read_text(encoding="utf-8").strip()
    except OSError:
        token = ""
    if not token:
        sys.exit("with-secrets: no Claude token in /run/ensemble/secrets; start a new container")
    os.execvpe(argv[0], argv, {**os.environ, "CLAUDE_CODE_OAUTH_TOKEN": token})


if __name__ == "__main__":
    main(sys.argv[1:])
