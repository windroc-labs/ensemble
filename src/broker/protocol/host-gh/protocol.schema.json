{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host gh broker protocol 1",
  "$defs": {
    "logged_in": {
      "type": "object",
      "required": ["version", "account", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "account": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
        "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
        "audit_warning": {"const": "audit_write_failed"}
      }
    }
  }
}
