{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docker broker protocol 26",
  "$comment": "Changes to the protocol format defined by this schema require bumping Version in src/broker/internal/protocol/protocol.go.",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
    },
    "session_name": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "const": "none"
      }
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^[0-9a-f]{32}$"
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^ensemble-worker:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "container": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^ensemble-[A-Za-z0-9_-]+-[0-9a-f]{32}$"
    },
    "workspace": {
      "type": "string",
      "pattern": "^ensemble-ws-[A-Za-z0-9_-]+$"
    },
    "github": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "app": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            },
            "permissions": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "actions",
                  "administration",
                  "checks",
                  "codespaces",
                  "contents",
                  "dependabot_secrets",
                  "deployments",
                  "environments",
                  "issues",
                  "metadata",
                  "packages",
                  "pages",
                  "pull_requests",
                  "repository_custom_properties",
                  "repository_hooks",
                  "secret_scanning_alerts",
                  "secrets",
                  "security_events",
                  "single_file",
                  "statuses",
                  "vulnerability_alerts",
                  "workflows"
                ]
              },
              "additionalProperties": {
                "enum": [
                  "read",
                  "write"
                ]
              },
              "properties": {
                "metadata": {
                  "const": "read"
                },
                "workflows": {
                  "const": "write"
                }
              }
            }
          },
          "required": [
            "app",
            "permissions"
          ],
          "additionalProperties": false
        }
      ]
    },
    "volume": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^unix:///[^\\u0000-\\u001f\\u007f]+/\\.docker/run/docker\\.sock$"
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "allOf": [
          {
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          }
        ],
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "not": {
          "pattern": "^(ensemble|windroc)\\."
        }
      },
      "additionalProperties": {
        "type": "string",
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f]"
        }
      }
    },
    "manifest": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/session_name"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "cwd": {
          "$ref": "#/$defs/path"
        },
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "claude_dir": {
          "$ref": "#/$defs/path"
        },
        "github": {
          "$ref": "#/$defs/github"
        },
        "hook_path": {
          "$ref": "#/$defs/path"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "client": {
          "enum": [
            "claude",
            "codex",
            "opencode"
          ]
        },
        "codex_dir": {
          "$ref": "#/$defs/path"
        },
        "opencode_dir": {
          "$ref": "#/$defs/path"
        },
        "opencode_providers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "not": {
              "const": "ollama"
            }
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "claude_account": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "not": {
            "const": "setup-token"
          }
        },
        "secrets": {
          "$comment": "Environment secrets by keychain reference; the broker also refuses a file repeated in the list and a file over 255 bytes.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "pattern": "^ensemble-env/[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^/\\u0000-\\u001f\\u007f-\\u009f]+$",
                "not": {
                  "enum": [".", ".."]
                }
              }
            },
            "required": ["item", "file"],
            "additionalProperties": false
          }
        },
        "lock": {
          "$ref": "#/$defs/lock_name"
        },
        "lock_owner": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "pattern": "\\S"
            }
          ]
        },
        "gateway": {
          "$comment": "The egress proxy's caller network key (windroc.egress.networks); absent: workers.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
        },
        "prefetch": {
          "$comment": "The repo a start clones into a workspace volume it creates; no ref: the default branch.",
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$",
              "not": {
                "pattern": "/\\.\\.?$"
              }
            },
            "ref": {
              "$ref": "#/$defs/git_ref"
            }
          },
          "required": ["repo"],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "generation",
        "image",
        "cwd",
        "workspace",
        "github",
        "labels",
        "client"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "client": {
              "const": "claude"
            }
          },
          "required": [
            "claude_dir"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "codex_dir"
                ]
              },
              {
                "required": [
                  "opencode_dir"
                ]
              },
              {
                "required": [
                  "opencode_providers"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "client": {
              "const": "codex"
            }
          },
          "required": [
            "codex_dir"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "claude_dir"
                ]
              },
              {
                "required": [
                  "opencode_dir"
                ]
              },
              {
                "required": [
                  "opencode_providers"
                ]
              },
              {
                "required": [
                  "claude_account"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "client": {
              "const": "opencode"
            }
          },
          "required": [
            "opencode_dir"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "claude_dir"
                ]
              },
              {
                "required": [
                  "codex_dir"
                ]
              },
              {
                "required": [
                  "claude_account"
                ]
              }
            ]
          }
        }
      ],
      "dependentRequired": {
        "lock": [
          "lock_owner"
        ],
        "lock_owner": [
          "lock"
        ]
      },
      "dependentSchemas": {
        "prefetch": {
          "$comment": "A prefetching container gets no GitHub credentials.",
          "properties": {
            "github": {
              "type": "null"
            }
          }
        }
      }
    },
    "version_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "version"
            }
          ],
          "items": false,
          "minItems": 1
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "version_output": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "29"
        }
      },
      "required": [
        "protocol_version"
      ],
      "additionalProperties": false
    },
    "build_input": {
      "type": "object",
      "properties": {
        "argv": {
          "$comment": "Then an optional --base-image IMAGE, then any --plugin SOURCE pairs, then any --image-plugin NAME pairs, then an optional --max-age SECONDS; JSON Schema cannot pair repeated tokens, so the broker checks the order (usage).",
          "type": "array",
          "prefixItems": [
            {
              "const": "build"
            },
            {
              "const": "--ensemble"
            },
            {
              "$ref": "#/$defs/path"
            }
          ],
          "items": {
            "anyOf": [
              {
                "enum": [
                  "--base-image",
                  "--plugin",
                  "--image-plugin",
                  "--max-age"
                ]
              },
              {
                "$ref": "#/$defs/plugin"
              },
              {
                "$ref": "#/$defs/plugin_name"
              },
              {
                "$ref": "#/$defs/base_image"
              },
              {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            ]
          },
          "minItems": 3,
          "anyOf": [
            {
              "maxItems": 3
            },
            {
              "minItems": 5
            }
          ]
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "build_output": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "rebuilt": {
          "type": "boolean"
        }
      },
      "required": [
        "image",
        "digest",
        "rebuilt"
      ],
      "additionalProperties": false
    },
    "start_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "start"
            },
            {
              "const": "--manifest"
            },
            {
              "$ref": "#/$defs/path"
            }
          ],
          "items": false,
          "minItems": 3
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "start_output": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/container"
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "image_digest": {
          "$ref": "#/$defs/digest"
        },
        "clients": {
          "type": "object",
          "properties": {
            "claude": {
              "$ref": "#/$defs/text"
            },
            "codex": {
              "$ref": "#/$defs/text"
            },
            "opencode": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "claude",
            "codex",
            "opencode"
          ],
          "additionalProperties": false
        },
        "github": {
          "$ref": "#/$defs/expiries"
        },
        "github_user_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "credential_expires_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "deadline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deadline"
            }
          ]
        },
        "audit_warning": {
          "$ref": "#/$defs/audit_warning"
        }
      },
      "required": [
        "container",
        "endpoint",
        "image_digest",
        "clients",
        "github",
        "github_user_id",
        "credential_expires_at",
        "deadline"
      ],
      "additionalProperties": false
    },
    "close_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "close"
            },
            {
              "const": "--container"
            },
            {
              "$ref": "#/$defs/container"
            }
          ],
          "items": false,
          "minItems": 3
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "close_output": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/container"
        },
        "removed": {
          "type": "boolean"
        },
        "audit_warning": {
          "$ref": "#/$defs/audit_warning"
        }
      },
      "required": [
        "container",
        "removed"
      ],
      "additionalProperties": false
    },
    "workspace_rm_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "workspace-rm"
            },
            {
              "const": "--volume"
            },
            {
              "$ref": "#/$defs/volume"
            },
            {
              "const": "--force"
            }
          ],
          "items": false,
          "minItems": 3
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "workspace_rm_output": {
      "type": "object",
      "properties": {
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "volume",
        "removed"
      ],
      "additionalProperties": false
    },
    "refresh_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "refresh"
            },
            {
              "const": "--container"
            },
            {
              "$ref": "#/$defs/container"
            },
            {
              "const": "--manifest"
            },
            {
              "$ref": "#/$defs/path"
            }
          ],
          "items": false,
          "minItems": 5
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "refresh_output": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/container"
        },
        "github": {
          "$ref": "#/$defs/expiries"
        },
        "credential_expires_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "audit_warning": {
          "$ref": "#/$defs/audit_warning"
        }
      },
      "required": [
        "container",
        "github",
        "credential_expires_at"
      ],
      "additionalProperties": false
    },
    "notice_key": {
      "type": "string",
      "pattern": "^ensemble-(claude|opencode|env)/[A-Za-z0-9._-]{1,64}@[0-9]{1,9}:(30d|7d|1d|expired|rotated)$"
    },
    "notices_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "notices"
            },
            {
              "const": "--container"
            },
            {
              "$ref": "#/$defs/container"
            },
            {
              "const": "--manifest"
            },
            {
              "$ref": "#/$defs/path"
            }
          ],
          "items": {
            "anyOf": [
              {
                "const": "--delivered"
              },
              {
                "$ref": "#/$defs/notice_key"
              }
            ]
          },
          "minItems": 5,
          "maxItems": 133
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "notices_output": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/container"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/notice_key"
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "key",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "next_check": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "audit_warning": {
          "$ref": "#/$defs/audit_warning"
        }
      },
      "required": [
        "container",
        "notices",
        "next_check"
      ],
      "additionalProperties": false
    },
    "deadline": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/time"
        },
        "action": {
          "enum": [
            "close"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "at",
        "action",
        "reason"
      ],
      "additionalProperties": false
    },
    "maintain_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "maintain"
            },
            {
              "const": "--container"
            },
            {
              "$ref": "#/$defs/container"
            },
            {
              "const": "--manifest"
            },
            {
              "$ref": "#/$defs/path"
            }
          ],
          "items": {
            "anyOf": [
              {
                "const": "--renew"
              },
              {
                "const": "--delivered"
              },
              {
                "$ref": "#/$defs/notice_key"
              }
            ]
          },
          "not": {
            "contains": {
              "const": "--renew"
            },
            "minContains": 2
          },
          "minItems": 5,
          "maxItems": 134
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "maintain_result": {
      "type": "object",
      "properties": {
        "credential": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "expires_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "usage",
                    "manifest_rejected",
                    "mount_rejected",
                    "login_required",
                    "image_rejected",
                    "docker_unreachable",
                    "build_failed",
                    "start_failed",
                    "close_failed",
                    "keychain_failed",
                    "workspace_dirty",
                    "workspace_rejected",
                    "workspace_failed",
                    "github_failed",
                    "refresh_failed",
                    "egress_unavailable",
                    "internal_error",
                    "busy"
                  ]
                },
                "message": {
                  "$ref": "#/$defs/text"
                },
                "cause": {
                  "$ref": "#/$defs/text"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "credential",
        "expires_at",
        "error"
      ],
      "additionalProperties": false
    },
    "maintain_output": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/container"
        },
        "next_check": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "deadline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deadline"
            }
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/maintain_result"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/notice_key"
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "key",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "audit_warning": {
          "$ref": "#/$defs/audit_warning"
        }
      },
      "required": [
        "container",
        "next_check",
        "deadline",
        "results",
        "notices"
      ],
      "additionalProperties": false
    },
    "status_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "status"
            },
            {
              "const": "--cleanup"
            }
          ],
          "items": false,
          "minItems": 1
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "status_output": {
      "type": "object",
      "properties": {
        "revocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "container": {
                "$ref": "#/$defs/container"
              },
              "account": {
                "$ref": "#/$defs/github_login"
              },
              "expires_at": {
                "$ref": "#/$defs/time"
              }
            },
            "required": [
              "container",
              "account",
              "expires_at"
            ],
            "additionalProperties": false
          }
        },
        "codex": {
          "$ref": "#/$defs/codex_status"
        },
        "claude": {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean"
            }
          },
          "required": [
            "default"
          ],
          "additionalProperties": false
        },
        "static": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string",
                "pattern": "^ensemble-(claude|opencode|env)/[A-Za-z0-9._-]{1,64}$"
              },
              "version": {
                "type": "integer",
                "minimum": 0
              },
              "expires_at": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/time"
                  }
                ]
              },
              "provenance": {
                "enum": [
                  "explicit",
                  "derived",
                  "assumed",
                  "unknown"
                ]
              },
              "notice": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/text"
                  }
                ]
              }
            },
            "required": [
              "reference",
              "version",
              "expires_at",
              "provenance",
              "notice"
            ],
            "additionalProperties": false
          }
        },
        "audit_warning": {
          "$ref": "#/$defs/audit_warning"
        }
      },
      "required": [
        "revocations"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "error": {
          "type": "object",
          "properties": {
            "command": {
              "enum": [
                "version",
                "build",
                "start",
                "maintain",
                "refresh",
                "notices",
                "close",
                "status",
                "workspace-rm",
                "unknown",
                "probe-provider",
                "lock-query",
                "check-clients"
              ]
            },
            "code": {
              "enum": [
                "usage",
                "manifest_rejected",
                "mount_rejected",
                "login_required",
                "image_rejected",
                "docker_unreachable",
                "build_failed",
                "start_failed",
                "close_failed",
                "keychain_failed",
                "workspace_dirty",
                "workspace_rejected",
                "workspace_failed",
                "github_failed",
                "refresh_failed",
                "egress_unavailable",
                "internal_error",
                "busy"
              ]
            },
            "message": {
              "$ref": "#/$defs/text"
            },
            "cleanup": {
              "enum": [
                "not_needed",
                "removed",
                "failed"
              ]
            },
            "cause": {
              "$ref": "#/$defs/text"
            },
            "cleanup_error": {
              "$ref": "#/$defs/text"
            },
            "container": {
              "$ref": "#/$defs/container"
            },
            "holder": {
              "$ref": "#/$defs/holder"
            }
          },
          "required": [
            "command",
            "code",
            "message",
            "cleanup"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "cleanup": {
                    "const": "failed"
                  }
                }
              },
              "then": {
                "required": [
                  "cleanup_error",
                  "container"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "cleanup_error"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "command": {
                    "not": {
                      "const": "start"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "cleanup": {
                    "const": "not_needed"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "busy"
                  }
                }
              },
              "then": {
                "required": [
                  "holder"
                ],
                "properties": {
                  "cleanup": {
                    "enum": [
                      "not_needed",
                      "removed"
                    ]
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "holder"
                  ]
                }
              }
            }
          ]
        },
        "audit_warning": {
          "$ref": "#/$defs/audit_warning"
        }
      },
      "required": [
        "exit_code",
        "error"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "exit_code": {
              "const": 2
            },
            "error": {
              "properties": {
                "code": {
                  "const": "usage"
                },
                "command": {
                  "enum": [
                    "version",
                    "build",
                    "start",
                    "maintain",
                    "refresh",
                    "notices",
                    "close",
                    "status",
                    "workspace-rm",
                    "unknown",
                    "probe-provider",
                    "lock-query",
                    "check-clients"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 3
            },
            "error": {
              "properties": {
                "code": {
                  "const": "manifest_rejected"
                },
                "command": {
                  "enum": [
                    "start",
                    "maintain",
                    "refresh",
                    "notices"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 4
            },
            "error": {
              "properties": {
                "code": {
                  "const": "mount_rejected"
                },
                "command": {
                  "enum": [
                    "start",
                    "maintain",
                    "refresh",
                    "notices"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 5
            },
            "error": {
              "properties": {
                "code": {
                  "const": "login_required"
                },
                "command": {
                  "enum": [
                    "start",
                    "refresh",
                    "probe-provider"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 6
            },
            "error": {
              "properties": {
                "code": {
                  "const": "image_rejected"
                },
                "command": {
                  "enum": [
                    "start"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 7
            },
            "error": {
              "properties": {
                "code": {
                  "const": "docker_unreachable"
                },
                "command": {
                  "enum": [
                    "build",
                    "start",
                    "refresh",
                    "close",
                    "workspace-rm",
                    "lock-query"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 8
            },
            "error": {
              "properties": {
                "code": {
                  "const": "build_failed"
                },
                "command": {
                  "enum": [
                    "build",
                    "check-clients"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 9
            },
            "error": {
              "properties": {
                "code": {
                  "const": "start_failed"
                },
                "command": {
                  "enum": [
                    "start",
                    "lock-query"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 10
            },
            "error": {
              "properties": {
                "code": {
                  "const": "close_failed"
                },
                "command": {
                  "enum": [
                    "close"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 11
            },
            "error": {
              "properties": {
                "code": {
                  "const": "keychain_failed"
                },
                "command": {
                  "enum": [
                    "start",
                    "refresh",
                    "close",
                    "status",
                    "probe-provider"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 12
            },
            "error": {
              "properties": {
                "code": {
                  "const": "workspace_dirty"
                },
                "command": {
                  "enum": [
                    "workspace-rm"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 13
            },
            "error": {
              "properties": {
                "code": {
                  "const": "workspace_rejected"
                },
                "command": {
                  "enum": [
                    "workspace-rm"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 14
            },
            "error": {
              "properties": {
                "code": {
                  "const": "workspace_failed"
                },
                "command": {
                  "enum": [
                    "workspace-rm"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 15
            },
            "error": {
              "properties": {
                "code": {
                  "const": "github_failed"
                },
                "command": {
                  "enum": [
                    "start",
                    "refresh"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 16
            },
            "error": {
              "properties": {
                "code": {
                  "const": "refresh_failed"
                },
                "command": {
                  "enum": [
                    "refresh"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 17
            },
            "error": {
              "properties": {
                "code": {
                  "const": "egress_unavailable"
                },
                "command": {
                  "enum": [
                    "start"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 70
            },
            "error": {
              "properties": {
                "code": {
                  "const": "internal_error"
                },
                "command": {
                  "enum": [
                    "version",
                    "build",
                    "start",
                    "maintain",
                    "refresh",
                    "notices",
                    "close",
                    "status",
                    "workspace-rm",
                    "unknown",
                    "probe-provider",
                    "lock-query",
                    "check-clients"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 75
            },
            "error": {
              "properties": {
                "code": {
                  "const": "busy"
                },
                "command": {
                  "const": "start"
                }
              }
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "audit_warning"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "command": {
                    "enum": [
                      "start",
                      "refresh",
                      "close",
                      "status"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "github_login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expiries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/$defs/github_login"
          },
          "expires_at": {
            "$ref": "#/$defs/time"
          }
        },
        "required": [
          "account",
          "expires_at"
        ],
        "additionalProperties": false
      }
    },
    "plugin": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}@[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}#[a-f0-9]{40}(?:::[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}#[a-f0-9]{40})?$"
    },
    "base_image": {
      "$comment": "A local image the broker layers ensemble on, never pulling it: a tag, repository[:tag] or sha256 ID; no registry port or digest.",
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?:sha256:[a-f0-9]{64}|[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?)$"
    },
    "plugin_name": {
      "$comment": "An in-image plugin: its directory under /opt/windroc/plugins in the stage-1 image.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "codex_status": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^((0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$"
        },
        "path": {
          "type": "string",
          "pattern": "^(/usr/local/libexec/ensemble/codex/releases/[^/\\x00-\\x20\\x7f]+/codex)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "logged_in": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "installation_invalid",
            "login_unavailable",
            "busy",
            "expired",
            "ready"
          ]
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        },
        "repair": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "path",
        "sha256",
        "logged_in",
        "state",
        "repair"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ready"
              }
            }
          },
          "then": {
            "required": [
              "expires_at"
            ],
            "properties": {
              "logged_in": {
                "const": true
              },
              "version": {
                "minLength": 1
              },
              "path": {
                "minLength": 1
              },
              "sha256": {
                "minLength": 64
              },
              "repair": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "logged_in": {
                "const": false
              },
              "repair": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "probe_provider_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "probe-provider"
            },
            {
              "const": "--provider"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            {
              "const": "--base-url"
            },
            {
              "type": "string",
              "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[^\\s/:?#@]+)(?::[0-9]+)?(?:/[^?#\\s]*)?$"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "probe_provider_output": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "available"
      ],
      "additionalProperties": false
    },
    "git_ref": {
      "$comment": "A branch or tag name, ensemble.utils.git.check_ref's rule (WDRC-109 FR-52).",
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]{1,255}$",
      "not": {
        "anyOf": [
          {"pattern": "^-"},
          {"const": "HEAD"},
          {"pattern": "^refs/"},
          {"pattern": "^[0-9a-fA-F]{7,64}$"},
          {"pattern": "\\.\\."},
          {"pattern": "\\.$"},
          {"pattern": "(^|/)(/|$)"},
          {"pattern": "(^|/)\\."},
          {"pattern": "\\.lock(/|$)"}
        ]
      }
    },
    "lock_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "holder": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "container",
        "owner"
      ],
      "additionalProperties": false
    },
    "lock_query_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "lock-query"
            },
            {
              "const": "--lock"
            },
            {
              "$ref": "#/$defs/lock_name"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "lock_query_output": {
      "type": "object",
      "properties": {
        "holder": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/holder"
            }
          ]
        }
      },
      "required": [
        "holder"
      ],
      "additionalProperties": false
    },
    "client_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "check_clients_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "check-clients"
            }
          ],
          "items": false,
          "minItems": 1
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "check_clients_output": {
      "type": "object",
      "properties": {
        "latest": {
          "type": "object",
          "properties": {
            "claude": {
              "$ref": "#/$defs/client_version"
            },
            "codex": {
              "$ref": "#/$defs/client_version"
            },
            "opencode": {
              "$ref": "#/$defs/client_version"
            }
          },
          "required": [
            "claude",
            "codex",
            "opencode"
          ],
          "additionalProperties": false
        },
        "rebuilt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image"
          }
        }
      },
      "required": [
        "rebuilt"
      ],
      "additionalProperties": false
    },
    "audit_warning": {
      "const": "audit_write_failed"
    }
  }
}
