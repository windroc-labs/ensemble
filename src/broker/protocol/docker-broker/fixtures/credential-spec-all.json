{
  "github": {
    "app": "ensemble-broker-bot",
    "permissions": {
      "contents": "write",
      "pull_requests": "write"
    },
    "repo": "windroc-labs/ensemble"
  },
  "linear": {
    "app": {
      "role": "engineer",
      "client_id": "dummy-engineer-client",
      "user_id": "00000000-0000-4000-8000-000000000002",
      "secret_service": "linear-app-engineer-secret",
      "token_service": "linear-app-engineer-token"
    },
    "board": {
      "team": "dummy-team-id",
      "states": {
        "backlog": "dummy-backlog",
        "todo": "dummy-todo",
        "in_progress": "dummy-in_progress",
        "in_review": "dummy-in_review",
        "handoff": "dummy-handoff",
        "done": "dummy-done",
        "canceled": "dummy-canceled"
      },
      "labels": {
        "task_labels": {
          "decompose": "dummy-decompose-label"
        },
        "agent_labels": {}
      },
      "project_repos": {
        "dummy-project-id": "windroc-labs/ensemble"
      },
      "human_members": [
        "dummy-human-id"
      ]
    }
  },
  "env": [
    {
      "item": "ensemble-broker-env/mini-ssh",
      "file": "id_ed25519"
    },
    {
      "item": "ensemble-broker-env/mini-password",
      "file": "mini-password"
    }
  ]
