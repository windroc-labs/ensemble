#!/usr/bin/env -S python3 -I
"""git pre-push hook: refuse a push to a public repository when what it publishes carries a leak.

Runs the pinned repo-guards scanner's leak checks (private-name, local-path, email) over what the
push publishes beyond the destination's own refs: each added blob's path and content, binary
included; each commit's message and author and committer names and emails; each annotated tag's
message and tagger; each pushed ref name. A junk path (__pycache__, node_modules, *.pyc, *.whl,
*.egg-info) also hits. Only a repository GitHub reports private or internal skips the scan; any
other answer or failure scans, any scan failure refuses, and so does a missing private-name list.
Output gives positions, never the matched text. After a clean scan the repository's own pre-push
runs through githook-forward.
"""

import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
import threading
from collections.abc import Iterator
from dataclasses import dataclass
from pathlib import Path

HOOKS_DIR = os.path.dirname(os.path.abspath(__file__))
LIB = Path(__file__).resolve().parent
SCANNER = LIB / "repo-guards-scan"
FORWARD = LIB / "githook-forward"
NAMES_ENV = "REPO_GUARDS_PRIVATE_NAMES"
NAMES_FILE = "/run/ensemble/secrets/env/repo-guards-private-names"
GITHUB = re.compile(
    r"(?:https?://(?:[^@/]+@)?github\.com/|ssh://(?:[^@/]+@)?github\.com(?::\d+)?/"
    r"|(?:[^@/:]+@)?github\.com:)([^/]+)/([^/]+?)(?:\.git)?/?"
)
NOT_PUBLIC = ("private", "internal")
JUNK_DIRS = ("__pycache__", "node_modules")
JUNK_SUFFIXES = (".pyc", ".pyo", ".whl", ".egg", ".egg-info")
GITLINK = "160000"
HINT = "fix: rewrite the listed commits or tags without these hits, then push again"


@dataclass(frozen=True)
class RefUpdate:
    local_ref: str
    local_sha: str
    remote_ref: str
    remote_sha: str


@dataclass(frozen=True)
class PushedFile:
    """A blob a pushed commit adds; `index` numbers it across the push, 1-based."""

    index: int
    commit: str
    path: str
    oid: str


@dataclass(frozen=True)
class Tag:
    sha: str
    tagger: str
    email: str
    message: str


def load_scanner():
    loader = importlib.machinery.SourceFileLoader("repo_guards_scan", str(SCANNER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def git(*args: str, stdin: bytes = b"") -> bytes:
    return subprocess.run(["git", *args], input=stdin, capture_output=True, check=True).stdout


def lines(items) -> bytes:
    return "".join(item + "\n" for item in items).encode()


def absent(sha: str) -> bool:
    return not sha.strip("0")


def parse_updates(text: str) -> list[RefUpdate]:
    return [RefUpdate(*line.split(" ")) for line in text.splitlines() if line]


def is_public(url: str) -> bool:
    match = GITHUB.fullmatch(url)
    if not match:
        return True
    endpoint = "repos/{}/{}".format(*match.groups())
    try:
        proc = subprocess.run(
            ["gh", "api", "--hostname", "github.com", endpoint, "--jq", ".visibility"],
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return True
    return proc.returncode != 0 or proc.stdout.strip() not in NOT_PUBLIC


def object_types(shas: list[str]) -> dict[str, str]:
    """Each sha's object type here, "missing" when this repository lacks it."""
    out = git("cat-file", "--batch-check", stdin=lines(shas)) if shas else b""
    return dict(line.split()[:2] for line in out.decode().splitlines())


def destination_tips(url: str, updates: list[RefUpdate]) -> list[str]:
    """The destination's ref tips this repository has: what they reach needs no scan."""
    advertised = {line.split("\t")[0] for line in git("ls-remote", url).decode().splitlines()}
    advertised |= {u.remote_sha for u in updates if not absent(u.remote_sha)}
    types = object_types(sorted(advertised))
    return [sha for sha, kind in types.items() if kind != "missing"]


def read_tag(sha: str) -> tuple[Tag, str, str]:
    """The tag, and the sha and type of the object it names."""
    head, _, message = git("cat-file", "tag", sha).decode("utf-8", "replace").partition("\n\n")
    fields = dict(line.split(" ", 1) for line in head.splitlines() if " " in line)
    tagger = re.fullmatch(r"(.*?) ?<([^>]*)>.*", fields.get("tagger", ""))
    name, email = (tagger[1], tagger[2]) if tagger else ("", "")
    return Tag(sha, name, email, message), fields["object"], fields["type"]


def pushed_refs(updates: list[RefUpdate]) -> tuple[list[Tag], list[str]]:
    """The annotated tags the push publishes and the commits its refs name."""
    tags, heads = [], []
    starts = [u.local_sha for u in updates if not absent(u.local_sha)]
    types = object_types(starts)
    for sha in starts:
        kind = types[sha]
        while kind == "tag":
            tag, sha, kind = read_tag(sha)
            tags.append(tag)
        if kind != "commit":
            raise ValueError(f"a pushed ref names a {kind}, which the scan cannot check")
        heads.append(sha)
    return tags, heads


def pushed_commits(heads: list[str], known: list[str]) -> list[str]:
    if not heads:
        return []
    revs = [*heads, *("^" + sha for sha in known)]
    out = git("rev-list", "--topo-order", "--reverse", "--stdin", stdin=lines(revs))
    return out.decode().split()


def pushed_files(commits: list[str]) -> list[PushedFile]:
    """Blobs each commit adds; a merge's are those differing from every parent (diff-tree -c)."""
    if not commits:
        return []
    out = git("diff-tree", "--stdin", "-r", "-z", "--root", "-c", stdin=lines(commits))
    files: list[PushedFile] = []
    tokens = iter(out.split(b"\0"))
    commit = ""
    for token in tokens:
        if not token.startswith(b":"):
            commit = token.decode().strip() or commit
            continue
        raw = next(tokens)
        parts = token.decode().lstrip(":").split()
        parents = len(parts) // 2 - 1
        mode, oid = parts[parents], parts[2 * parents + 1]
        if not absent(oid) and mode != GITLINK:
            files.append(PushedFile(len(files) + 1, commit, os.fsdecode(raw), oid))
    return files


def blob_contents(oids: list[str]) -> Iterator[tuple[str, bytes]]:
    """Each blob in turn, so memory holds one blob at a time."""
    proc = subprocess.Popen(
        ["git", "cat-file", "--batch"], stdin=subprocess.PIPE, stdout=subprocess.PIPE
    )
    stdin, stdout = proc.stdin, proc.stdout
    assert stdin is not None and stdout is not None

    def feed():
        with stdin:
            stdin.write(lines(oids))

    feeder = threading.Thread(target=feed, daemon=True)
    feeder.start()
    for oid in oids:
        size = int(stdout.readline().split()[2])
        data = stdout.read(size)
        stdout.read(1)
        yield oid, data
    feeder.join()
    stdout.close()
    if proc.wait():
        raise subprocess.CalledProcessError(proc.returncode, "git cat-file --batch")


def load_names(scanner) -> list[str] | None:
    if NAMES_ENV in os.environ or not os.path.isfile(NAMES_FILE):
        return scanner.load_names(None, os.getcwd())
    return scanner.load_names(NAMES_FILE, os.getcwd())


def is_junk(path: str) -> bool:
    return any(part in JUNK_DIRS or part.endswith(JUNK_SUFFIXES) for part in path.split("/"))


class Scan:
    """One push's scanner report: every leak check, plus junk paths."""

    def __init__(self, scanner):
        self.scanner = scanner
        self.junk = scanner.Check(name="junk", klass=scanner.LEAK, in_paths=True)
        checks = [c for c in scanner.CHECKS.values() if c.klass == scanner.LEAK]
        self.report = scanner.Report([*checks, self.junk])
        self.finders = {
            c: scanner.TEXT_FINDERS[c.name] for c in checks if c.name in scanner.TEXT_FINDERS
        }
        names = load_names(scanner)
        private = scanner.CHECKS["private-name"]
        if names is None:
            self.report.unavailable = True
        else:
            self.finders[private] = scanner.private_name_finder(names)
        unrun = [c.name for c in checks if c not in self.finders and c is not private]
        if unrun:
            raise ValueError("no finder for the leak check(s) " + ", ".join(unrun))

    def text(self, text: str, where) -> None:
        self.scanner.scan_text(self.report, self.finders, text, where)

    def files(self, files: list[PushedFile]) -> None:
        """Every path; each distinct blob's content once, at its first file."""
        where, first = self.scanner.Where, {}
        for f in files:
            first.setdefault(f.oid, f)
            if is_junk(f.path):
                self.report.add(self.junk, where(f.path, f.index, field="path"))
            for check, find in self.finders.items():
                if check.in_paths and find(f.path):
                    self.report.add(check, where(f.path, f.index, field="path"))
        for oid, data in blob_contents(list(first)):
            f = first[oid]
            self.text(data.decode("utf-8", "replace"), where(f.path, f.index))

    def commits(self, commits: list[str]) -> None:
        if not commits:
            return
        out = git(
            "log",
            "--no-walk=unsorted",
            "--stdin",
            "-z",
            "--format=%H%x00%an%x00%ae%x00%cn%x00%ce%x00%B",
            stdin=lines(commits),
        )
        fields = out.decode("utf-8", "replace").split("\0")
        records = []
        for i in range(0, len(fields) - 5, 6):
            sha, author, author_email, committer, committer_email, message = fields[i : i + 6]
            records.append(self.scanner.Commit(sha, author_email, committer_email, message))
            self.text(author, self.scanner.Where(sha=sha, field="author name"))
            self.text(committer, self.scanner.Where(sha=sha, field="committer name"))
        self.scanner.scan_commits(self.report, self.finders, records)

    def tags(self, tags: list[Tag]) -> None:
        where, email = self.scanner.Where, self.scanner.CHECKS["email"]
        for tag in tags:
            self.text(tag.message, where(field=f"tag {tag.sha} message"))
            self.text(tag.tagger, where(field=f"tag {tag.sha} tagger name"))
            if tag.email and not self.scanner.email_allowed(tag.email):
                self.report.add(email, where(field=f"tag {tag.sha} tagger", line=1))

    def refusal(self, files: list[PushedFile]) -> str | None:
        if not self.report.failed():
            return None
        rendered = self.report.render(public=False).splitlines()
        out = [line for line in rendered if line != self.scanner.LEAK_NOTICE]
        commit_of = {f.index: f.commit for f in files}
        hit = sorted({where.index for _, where in self.report.hits if where.index})
        out += [
            f"file #{i}: changed in commit {commit_of[i]} (diff-tree -r --root -c order)"
            for i in hit
        ]
        return "\n".join(
            ["pre-push: refused, this push to a public repository has hits:", *out, HINT]
        )


def scan(url: str, updates: list[RefUpdate]) -> str | None:
    """The refusal text, or None when the push is clean."""
    check = Scan(load_scanner())
    tags, heads = pushed_refs(updates)
    commits = pushed_commits(heads, destination_tips(url, updates))
    files = pushed_files(commits)
    check.files(files)
    check.commits(commits)
    check.tags(tags)
    for number, update in enumerate(updates, 1):
        check.text(update.remote_ref, check.scanner.Where(field=f"pushed ref #{number}"))
    return check.refusal(files)


def run_repo_hook(argv: list[str], stdin: bytes) -> int:
    env = {**os.environ, "ENSEMBLE_GITHOOK_NAME": "pre-push", "ENSEMBLE_GITHOOK_DIR": HOOKS_DIR}
    return subprocess.run([str(FORWARD), *argv], input=stdin, env=env, check=False).returncode


def main(argv: list[str], stdin: bytes) -> int:
    try:
        if is_public(argv[1]):
            refusal = scan(argv[1], parse_updates(stdin.decode()))
            if refusal is not None:
                print(refusal, file=sys.stderr)
                return 1
    except Exception as error:  # Any failure refuses the push.
        name = type(error).__name__
        print(
            f"pre-push: refused, the leak scan failed ({name}); fix it, then push again",
            file=sys.stderr,
        )
        return 1
    return run_repo_hook(argv, stdin)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], sys.stdin.buffer.read()))
