#!/usr/bin/env bash
# A manager's place. ensemble <name> opens tmux session <name>, whose shell holds manager <name>'s
# place while it lives (this script's <name> -- form); start the client there. The holding, listing
# and resuming run in this plugin's ensemble.manager.ensemble_command, so no manager can be named
# list or resume here. On a terminal list then opens the selected manager: attach to its session,
# resume its recorded client under its hold (ensemble resume typed into the hold's idle shell, or as
# a new hold's command), or ensemble <name>.
# --install (re)writes ~/.ensemble/bin's launchers and selects this plugin for every command.
usage() {
  printf '%s\n' \
    'usage: ensemble <name> | ensemble [--force] <name> -- <command> [<arg> ...]' \
    '       ensemble list | ensemble resume | ensemble --install | ensemble -h | ensemble --help' \
    '<name>: letters, digits, _ and -; must not start with -; not list or resume' \
    'ensemble <name>      open tmux session <name>, whose shell holds manager <name>'"'"'s place' \
    '                     while it lives; start the client there' \
    'ensemble <name> -- <command>' \
    '                     hold <name>'"'"'s place while <command> runs in this terminal, in or' \
    '                     outside tmux; a place another holder keeps is refused' \
    '  --force            take that place over and fence its holder, e.g. a stuck one' \
    'ensemble list        print every manager; on a terminal, select one to attach or resume' \
    'ensemble resume      in a held shell, resume the manager'"'"'s recorded client; exit 2 unheld' \
    'examples:' \
    '  ensemble demo -- <client> [<arg> ...]        start a client holding demo, outside tmux too' \
    '  ensemble --force demo -- <client resume command>' \
    '                     take demo over and resume its conversation in this terminal' \
    '<client resume command>: the client command resuming the manager'"'"'s conversation;' \
    '                     ensemble-session resume-argv <client> <sid> prints it, with the' \
    '                     client and sid in ~/.ensemble/managers/<name>/session.json'
}
usage_error() {
  usage >&2
  exit 2
}
valid_name() {
  local LC_ALL=C
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]]
}
for argument in "$@"; do
  case $argument in --) break ;; -h | --help) usage; exit 0 ;; esac
done
force=
case ${1:-} in
--install | resume) [ $# -eq 1 ] || usage_error ;;
list) ;;
*)
  [ "${1:-}" = --force ] && { force=--force; shift; }
  case ${1:-} in -* | list | resume) usage_error ;; esac
  valid_name "${1:-}" || usage_error
  if [ $# -eq 1 ]; then
    [ -z "$force" ] || usage_error
  else
    [ "$2" = -- ] && [ $# -gt 2 ] || usage_error
  fi
  ;;
esac
if [ "$1" = --install ]; then
  root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P) || exit
  bin=$HOME/.ensemble/bin
  mkdir -p "$bin" || exit
  for name in ensemble ensemble-crew ensemble-session ensemble-delegate ensemble-orchestrator; do
    install -m 755 "$(dirname -- "$0")/launcher" "$bin/$name" && echo "$bin/$name" || exit
  done
  "$(dirname -- "$0")/launcher" --select "$root" || exit
  exit
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd) || exit
self=$root/skills/manage/scripts/ensemble
side=$root/src/ensemble/manager/ensemble_command.py
paths=$root
case $root in
  *:*) # PATH and PYTHONPATH split on ":" (OpenCode's plugin cache path holds one): name the root through a link without it
    paths=$HOME/.ensemble/links/$(printf '%s' "$root" | cksum | cut -d' ' -f1)
    mkdir -p "$HOME/.ensemble/links" || exit
    [ "$(readlink "$paths" 2>/dev/null)" = "$root" ] || ln -sfn "$root" "$paths" || exit
    ;;
esac
manager=(env "PATH=$paths/bin:$PATH" "PYTHONPATH=$paths/src" python3 -P -m ensemble.manager.ensemble_command)
require_side() {
  [ -f "$side" ] || { echo "ensemble: no $side" >&2; exit 1; }
}
# openable NAME: refuse a manager the <name> form cannot hold, such as one an older ensemble
# named resume; its new session's shell would exit at once.
openable() {
  case $1 in -* | list | resume) ;; *) valid_name "$1" && return ;; esac
  echo "ensemble: manager $1 cannot be opened by ensemble; nothing opened" >&2
  exit 1
}
if [ $# -gt 1 ] && [ "$1" != list ]; then
  require_side
  s=$1
  shift 2
  exec "${manager[@]}" hold ${force:+"$force"} "$s" -- "$@"
fi
if [ "$1" = resume ]; then
  require_side
  exec "${manager[@]}" resume
fi
# start NAME DIR COMMAND...: a detached session NAME in DIR running COMMAND.
start() {
  local s=$1 dir=$2
  shift 2
  # Start from ~ so the tmux server never sits in a directory that later gets deleted.
  (cd ~ && tmux start-server \; set -g mouse on \; set -g history-limit 50000 \
    \; set -s extended-keys on \; set -s 'terminal-features[99]' 'xterm*:extkeys' \
    \; new -d -s "$s" -c "${dir//\#/##}" "$@")
}
# hold_pane NAME: "ID COMMAND START" of the one pane in session NAME whose command is NAME's own
# hold, ensemble NAME -- … (tmux prints a tab in a format as _, so fields are space-separated).
hold_pane() {
  local panes
  panes=$(tmux list-panes -s -t "=$1" -F '#{pane_id} #{pane_current_command} #{pane_start_command}' \
    2>/dev/null | grep -E -- "/ensemble[\"']? $1 -- ") || return
  [ "$(printf '%s\n' "$panes" | wc -l)" -eq 1 ] && printf '%s\n' "$panes"
}
# workers_window NAME: the window of session NAME's newest pane its manager NAME opened for a worker.
workers_window() {
  local opener id window newest=-1 found=
  while read -r opener id window; do
    [ "$opener" = "$1" ] && [ "${id#%}" -gt "$newest" ] && newest=${id#%} found=$window
  done < <(tmux list-panes -s -t "=$1" -F '#{@worker-opener} #{pane_id} #{window_id}' 2>/dev/null)
  [ -n "$found" ] && printf '%s\n' "$found"
}
# beside WINDOW DIR COMMAND...: print the id of a new full-height pane in DIR running COMMAND, left
# of WINDOW's panes, where a manager's pane sits when it opens its first worker.
beside() {
  local window=$1 dir=$2
  shift 2
  tmux split-window -b -f -h -P -F '#{pane_id}' -t "$window" -c "${dir//\#/##}" "$@"
}
# attach NAME [PANE]: show session NAME, at PANE when given.
attach() {
  [ -z "${2:-}" ] || tmux select-window -t "$2" \; select-pane -t "$2"
  if [ -n "$TMUX" ]; then
    exec tmux switch-client -t "=$1"
  elif [ "$TERM_PROGRAM" = iTerm.app ] || [ "$LC_TERMINAL" = iTerm2 ]; then # LC_TERMINAL survives ssh
    exec tmux -CC attach -t "=$1"
  fi
  exec tmux attach -t "=$1"
}
if [ "$1" = list ]; then
  require_side
  shift
  [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ] || exec "${manager[@]}" list "$@"
  # Ctrl-C at the prompt cancels: the list exits 0, and bash must not die of the SIGINT meanwhile.
  trap : INT
  plan=$("${manager[@]}" list --select) || exit
  trap - INT
  [ -n "$plan" ] || exit 0
  read -r verb s <<<"$plan"
  case $verb in
  open)
    openable "$s"
    set -- "$s"
    ;;
  resume-new)
    openable "$s"
    held=("$self" "$s" -- /bin/sh -c '"$@"; exec "${SHELL:-/bin/sh}" -l' ensemble "$self" resume)
    if tmux has -t "=$s" 2>/dev/null; then
      window=$(workers_window "$s") || window="=$s:"
      pane=$(beside "$window" "$PWD" "${held[@]}") && attach "$s" "$pane"
    fi
    start "$s" "$PWD" "${held[@]}"
    attach "$s"
    ;;
  attach | resume-held)
    pane=$(hold_pane "$s") || {
      echo "ensemble: manager $s is held by $s outside tmux session $s; nothing opened" >&2
      exit 1
    }
    read -r id running _ <<<"$pane"
    [ "$verb" = attach ] && attach "$s" "$id"
    # A login shell may reset PATH, so ensemble is typed by path: quoted only when it must be, and
    # not at all when no shell could take it.
    shell=${SHELL:-/bin/sh} resume="$self resume"
    case $self in
    *[\'\\]*) running="a shell that cannot take $self" ;;
    *[!A-Za-z0-9_./:@,+-]*) resume="'$self' resume" ;;
    esac
    if [ "$running" = "${shell##*/}" ]; then
      tmux send-keys -t "$id" C-u \; send-keys -t "$id" -l "$resume" \; send-keys -t "$id" Enter
    else
      echo "ensemble: $s's pane runs $(printf '%s' "$running" | tr -cd '[:print:]');" \
        "resume there with: $resume" >&2
    fi
    attach "$s" "$id"
    ;;
  *)
    echo "ensemble: unknown plan: $plan" >&2
    exit 1
    ;;
  esac
fi
s=$1
hold=("$self" "$s" -- "${SHELL:-/bin/sh}" -l)
if tmux has -t "=$s" 2>/dev/null; then
  if pane=$(hold_pane "$s"); then
    attach "$s" "${pane%% *}"
  elif window=$(workers_window "$s"); then
    # Its workers outlived its hold shell: a new one goes back beside them.
    require_side
    pane=$(beside "$window" "$PWD" "${hold[@]}") && attach "$s" "$pane"
  fi
  attach "$s"
fi
require_side
start "$s" "$PWD" "${hold[@]}"
attach "$s"
